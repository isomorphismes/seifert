module Seifert


-- Host-only numerical prototype over the inherited binary64 representation.
-- This is not the native C float ABI or a qualified Float16/Float32 backend.
-- The semantic ICKY C source is ../icky/seifert.c.
-- The public boundary is ../native/seifert.h.

public export
PrototypeScalar : Type
PrototypeScalar = Double

public export
record Vec2 where
  constructor XY
  x : PrototypeScalar
  y : PrototypeScalar

public export
record Vec3 where
  constructor XYZ
  x : PrototypeScalar
  y : PrototypeScalar
  z : PrototypeScalar

public export
data BlockId = UpperBlock | CornerBlock | RightBlock

public export
record Block where
  constructor RigidBlock
  center : Vec2
  half_extent : PrototypeScalar
  unwrapped_angle : PrototypeScalar

public export
record Ribbon where
  constructor BetweenBlocks
  from : BlockId
  to : BlockId
  half_width : PrototypeScalar

public export
record ThreeBlockScene where
  constructor Scene
  upper : Block
  corner : Block
  right : Block
  vertical_ribbon : Ribbon
  horizontal_ribbon : Ribbon

-- Positive orthant: corner.x = upper.x, corner.y = right.y,
-- corner.y < upper.y and corner.x < right.x, cubes disjoint.
-- Each angle acts through its cube center about the fixed unit
-- spatial diagonal (1,1,1)/sqrt(3), not about two incompatible axes.

public export
data TwistCommand = Turn BlockId PrototypeScalar | ResetBlock BlockId

-- Future API, deliberately not an undefined executable declaration:
-- step_scene : ThreeBlockScene → TwistCommand → ThreeBlockScene

public export
record RibbonVertex where
  constructor RibbonPoint
  position : Vec3
  u : PrototypeScalar
  side : Number

public export
record RibbonMesh where
  constructor Mesh
  vertices : List RibbonVertex
  triangles : List (Number, Number, Number)

-- Future API, implemented only in native geometry today:
-- sample_ribbons : ThreeBlockScene → Number → RibbonMesh

-- Pointer capture is owned by the Android adapter and depends on
-- a single stable selected block and pointer id until release.
public export
data GrabTarget = NoGrab | BlockGrab BlockId

public export
record PointerInteraction where
  constructor Gesture
  grab : GrabTarget
  previous_x : PrototypeScalar

-- Not a Seifert-surface proof. These are two ruled, deformable bands
-- attached to rotating cubical bodies, not an orientable spanning
-- surface with a verified boundary link.
