#!/usr/bin/env grease
# Existing compiler and GLES prerequisites must already be provisioned.
var root = $(git -C "$[ARGV[0]]" rev-parse --show-toplevel)
var compiler = ENV.ICK
var gl_include = ENV.SEIFERT_GL_INCLUDE
test -x "$compiler"
test -f "$gl_include/EGL/egl.h"
test -f "$gl_include/GLES2/gl2.h"
mkdir -p "$root/build/live-readouts"
"$compiler" -fno-link-libatomic -std=c11 -O2 -Wall -Wextra -Werror -Wpedantic \
  -I "$root/native" "$root/icky/seifert.c" "$root/icky/seifert_readouts.c" \
  "$root/examples/autogenerated/live-readouts/test_readouts.c" -lm \
  -o "$root/build/live-readouts/test-readouts"
"$root/build/live-readouts/test-readouts"
"$compiler" -fno-link-libatomic -std=c11 -O2 -Wall -Wextra -Werror -Wpedantic \
  -I "$root/native" -I "$root/android" -idirafter "$gl_include" \
  "$root/icky/seifert.c" "$root/icky/seifert_readouts.c" \
  "$root/android/seifert_view.c" "$root/android/seifert_renderer.c" \
  "$root/examples/autogenerated/live-readouts/render_readouts.c" \
  -l:libEGL.so.1 -l:libGLESv2.so.2 -lm \
  -o "$root/build/live-readouts/render-readouts"
"$root/build/live-readouts/render-readouts" "$root/build/live-readouts/readouts.ppm"
printf '\033[32mPASS\033[0m native mathematical readouts and real host GLES display\n'
