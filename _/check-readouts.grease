#!/usr/bin/env grease
var root = $(git -C "$[ARGV[0]]" rev-parse --show-toplevel)
var compiler = ENV.IDRIC_COMPILER
cd "$root"
$compiler --source-dir types --check types/ArithmeticTopology.idric
env IDRIS2_PATH="$root/build/ttc" $compiler \
  --source-dir examples/autogenerated/topology-readouts \
  examples/autogenerated/topology-readouts/ReadoutChecks.idric \
  --exec ReadoutChecks.main
