#!/usr/bin/env grease
# Fixed shared owner checkout; these are vendored copies, not a second palette.
var owner = ARGV[0]
test $(git -C "$owner" rev-parse HEAD) = 3e682fb1175beef5625dbd2418730220e49fc9bd
cmp "$owner/native/presentation/charcoal.h" android/charcoal.h
cmp "$owner/native/presentation/res/values/charcoal.xml" android/res/values/charcoal.xml
cmp "$owner/native/presentation/res/values-v21/charcoal.xml" android/res/values-v21/charcoal.xml
cmp "$owner/native/presentation/res/values-v31/charcoal.xml" android/res/values-v31/charcoal.xml
cmp "$owner/native/presentation/res/color/charcoal_text_states.xml" android/res/color/charcoal_text_states.xml
printf 'PASS: canonical charcoal header and resources match the shared owner\n'
